# ============================================================
# VISOR360 - Backend (.env.example)
# Plantilla de variables de entorno. Copia este archivo a ".env"
# y rellena los valores reales. El .env NO se versiona (esta en
# .gitignore); este .example SI, para documentar que variables
# existen.
# ============================================================

# --- BD 1: export_planeacion (recaudo, portafolio, P&L) ---
DB1_SERVER=172.18.79.20
DB1_DATABASE=export_planeacion
DB1_USERNAME=
DB1_PASSWORD=

# --- BD 2: LOGS (usuarios, roles, permisos, campanas) ---
DB2_SERVER=172.18.72.111
DB2_DATABASE=LOGS
DB2_USERNAME=
DB2_PASSWORD=

# --- BD 3: Portafolio (vista vw_recaudos_portafolio) ---
# Normalmente igual a BD1
DB3_SERVER=172.18.79.20
DB3_DATABASE=export_planeacion
DB3_USERNAME=
DB3_PASSWORD=
